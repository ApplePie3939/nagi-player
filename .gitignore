# Personal media: keep purchased files local and out of the public repository.
# The three tracked demo files remain included for development and deployment.
/assets/media/*
!/assets/media/README.md
!/assets/media/taiko2.mp3
!/assets/media/cat-jumpscare-h264.mp4

# Name personal artwork as private-<name>.<extension> to keep it local too.
/assets/artwork/private-*
